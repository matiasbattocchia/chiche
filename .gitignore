.env
node_modules/
# chiche: one folder per run, and the kid's browser profile
log/
.browser/
# data/ is the agents' volume: track what they are, not what they did
data/log/
data/run/
data/relay/
data/system/
data/organization/games/
# the asset library's packs: `game assets import` fetches them again; CREDITS.md is tracked
data/organization/assets/*/
data/organization/assets/.sheets/
data/agents/*/*
!data/agents/*/instructions/
!data/agents/*/skills/
!data/agents/*/bin/

# voice clips stay local
deprecated/tests/fixtures/*.raw
