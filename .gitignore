.env
node_modules/
# chiche: one folder per run, and the kid's browser profile
log/
.browser/
# data/ is the agents' volume: track what they are, not what they did
data/log/
data/run/
data/relay/
# the harness's own words, read live from the checkout; no system skills
data/system/*
!data/system/instructions
!data/system/tools
!data/system/skills/
data/organization/.playwright-cli/
data/organization/projects/*
!data/organization/projects/.gitkeep
data/agents/*/*
!data/agents/*/instructions/
!data/agents/*/skills/
!data/agents/*/bin/

# voice clips stay local
deprecated/tests/fixtures/*.raw
