// deno.jsonc — liquen's tasks (its scaffold), plus chiche: `deno task chiche` runs the
// voice. A liquen checkout stands in for the registry with `"links": ["../liquen"]`.
{
  "links": ["../liquen"],
  "imports": {
    "@liquen/liquen": "jsr:@liquen/liquen@^0.1.0",
    "@google/genai": "npm:@google/genai@2.24.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/streams": "jsr:@std/streams@^1.0.0"
  },
  "fmt": {
    "lineWidth": 100
  },
  "tasks": {
    "chiche": "deno run -A --env-file=.env main.ts",
    "start": "deno run -A --env-file=.env @liquen/liquen/start",
    "stop": "deno run -A @liquen/liquen/stop",
    "update": "deno run -A @liquen/liquen/update",
    "cli": "deno run -A --env-file=.env @liquen/liquen/cli",
    "repl": "deno run -A --env-file=.env @liquen/liquen/repl",
    "agent": "deno run -A @liquen/liquen/agent",
    "schedule": "deno run -A @liquen/liquen/schedule",
    "connect": "deno run -A --env-file=.env @liquen/liquen/connect",
    "status": "deno run -A --env-file=.env @liquen/liquen/status"
  }
}
